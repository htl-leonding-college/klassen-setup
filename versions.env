# Werkzeugversionen des Schuljahres — die eine Stelle, an der sie stehen.
# Je Schuljahr ein git-Tag auf diesem Stand, damit er rekonstruierbar bleibt.

SCHULJAHR="2026/27"

# Java-Stack über SDKMAN (ein Mechanismus auf Ubuntu und macOS)
# Jede Kennung hier muss in SDKMAN existieren — prüfen mit "sdk list java".
# TODO: mit 4./5. Jahrgang abstimmen, bevor der Tag gesetzt wird.
JAVA_VERSION="25.0.4-tem"
MAVEN_VERSION="3.9.9"
GRADLE_VERSION="8.14"

# Bewusst NICHT hier: die JetBrains Toolbox. JetBrains veröffentlicht unter
# ihrem Produktcode immer nur den aktuellen Build und räumt alte weg — ein Pin
# wäre eine Zusage, die die Quelle nicht einhält. setup-tools.sh lädt dort
# den jeweils aktuellen Stand und prüft dessen SHA-256 gegen die
# veröffentlichte Prüfsumme.

# Container und Orchestrierung
KUBECTL_VERSION="1.32.2"
MINIKUBE_VERSION="1.35.0"

# Ubuntu-Basis, gegen die setup-tools.sh im Container geprüft wird
# (.github/workflows/setup.yml). Läuft das Script auf einer anderen Version,
# sagt es das beim Start.
UBUNTU_RELEASE="26.04"
